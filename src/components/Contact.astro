---
import ArrowUpRight from "@lucide/astro/icons/arrow-up-right";
import { contact, profile } from "../data/profile";
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="studio-chapter studio-contact"
  data-studio-chapter
  data-studio-side="left"
  data-studio-label="An open invitation"
>
  <div class="studio-copy">
    <p class="studio-section-label">
      <span>05 / Contact</span>
      <span>Get in touch</span>
    </p>
    <h2 id="contact-title">{contact.title}</h2>
    <p class="studio-description">{contact.description}</p>
    <a class="studio-contact-email" href={"mailto:" + profile.email}>
      {profile.email}
      <ArrowUpRight size={20} />
    </a>
    <div class="studio-contact-links">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn <ArrowUpRight size={14} />
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub <ArrowUpRight size={14} />
      </a>
      <a href={"tel:" + profile.phone}>
        Phone <ArrowUpRight size={14} />
      </a>
    </div>
    <a class="studio-back" href="#top">
      Back to the room ↑
    </a>
  </div>
</section>
