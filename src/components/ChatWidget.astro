---
import MessageCircle from "@lucide/astro/icons/message-circle";
import { chat, profile } from "../data/profile";
import ChatPanel from "./ChatPanel";

const panelId = "chat-panel";
---

<button
  type="button"
  popovertarget={panelId}
  aria-label="Buka chat dengan asisten Rahmat"
  lang="id"
  data-chat-launcher
  class="fixed right-4 bottom-6 z-40 grid size-14 place-items-center rounded-pill bg-accent text-paper shadow-launcher hover:-translate-y-0.5 hover:bg-accent-hover motion-safe:transition-[background-color,translate,opacity] max-lg:data-hidden:not-focus-visible:pointer-events-none max-lg:data-hidden:not-focus-visible:translate-y-24 max-lg:data-hidden:not-focus-visible:opacity-0 lg:right-18 lg:bottom-16 lg:size-15"
>
  <MessageCircle size={26} />
  <span
    class="absolute top-[3px] right-1 size-[13px] rounded-full border-2 border-accent bg-online lg:top-1 lg:size-3.5"
    aria-hidden="true"></span>
</button>

<div
  id={panelId}
  popover
  role="dialog"
  aria-label={`Chat dengan ${chat.assistant}`}
  lang="id"
  class="fixed inset-x-4 top-auto bottom-24 m-0 h-[500px] max-h-[calc(100dvh-8rem)] w-auto translate-y-2 flex-col overflow-hidden rounded-[16px] border border-line bg-paper p-0 text-ink opacity-0 shadow-float open:flex open:translate-y-0 open:opacity-100 starting:open:translate-y-2 starting:open:opacity-0 motion-safe:transition-[opacity,translate,display,overlay] motion-safe:transition-discrete motion-safe:duration-200 lg:right-18 lg:bottom-36 lg:left-auto lg:h-[520px] lg:max-h-[calc(100dvh-11rem)] lg:w-94 lg:rounded-md"
>
  <ChatPanel
    client:visible
    panelId={panelId}
    assistant={chat.assistant}
    initials={chat.initials}
    status={chat.status}
    greeting={chat.greeting}
    suggestions={chat.suggestions}
    email={profile.email}
    github={profile.github}
    linkedin={profile.linkedin}
  />
</div>

<script>
  import { launcherHidden } from "../scripts/chat-launcher";

  // Hidden state yields to :focus-visible in CSS, so Tab still reaches the launcher.
  const launcher = document.querySelector<HTMLElement>("[data-chat-launcher]");
  const panel = document.querySelector<HTMLElement>("#chat-panel");
  let lastY = scrollY;

  addEventListener(
    "scroll",
    () => {
      const hidden = launcherHidden(lastY, scrollY, !!panel?.matches(":popover-open"));
      if (hidden === undefined) return;
      lastY = scrollY;
      launcher?.toggleAttribute("data-hidden", hidden);
    },
    { passive: true },
  );
</script>
