---
import { navigation, profile } from "../data/profile";
import PluckedLink from "./PluckedLink.astro";
---

<header class="site-header">
  <span class="site-progress" aria-hidden="true">
    <span data-scroll-progress></span>
  </span>
  <PluckedLink
    class="site-wordmark"
    href={Astro.url.pathname === "/" ? "#top" : "/"}
    current={Astro.url.pathname === "/"}
  >
    {profile.wordmark}
  </PluckedLink>
  <nav class="site-desktop-nav" aria-label="Main navigation">
    {navigation.map((link) => (
      <PluckedLink href={link.href}>{link.label}</PluckedLink>
    ))}
  </nav>
  <details class="site-mobile-menu" data-navigation-menu>
    <summary>
      Menu <span aria-hidden="true">+</span>
    </summary>
    <nav aria-label="Mobile navigation">
      {navigation.map((link) => (
        <PluckedLink href={link.href}>{link.label}</PluckedLink>
      ))}
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(
    "[data-navigation-menu]",
  );
  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
  menu?.addEventListener("keydown", (event) => {
    if (
      event.key === "Enter" &&
      event.target === menu.querySelector("summary")
    ) {
      event.preventDefault();
      menu.open = !menu.open;
    } else if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
</script>
