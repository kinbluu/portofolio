---
import { contact, profile } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("contact");
---

<section
  id={chapter.id}
  aria-labelledby="contact-title"
  class="editorial-section editorial-contact"
>
  <div class="editorial-inner editorial-measure">
    <h2 id="contact-title">Contact</h2>
    <p class="editorial-copy">{contact.description}</p>
    <a class="editorial-email" href={"mailto:" + profile.email}>
      {profile.email}
    </a>
    <nav class="editorial-contact-links" aria-label="Contact options">
      <a href={profile.linkedin} target="_blank" rel="noopener noreferrer">
        LinkedIn
      </a>
      <a href={profile.github} target="_blank" rel="noopener noreferrer">
        GitHub
      </a>
      <a href={"tel:" + profile.phone}>Phone</a>
      <a href="#top">Back to top</a>
    </nav>
  </div>
</section>
