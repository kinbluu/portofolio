---
import About from "../components/About.astro";
import ChatWidget from "../components/ChatWidget.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import FeaturedRole from "../components/FeaturedRole.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import Intro from "../components/Intro.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.role} in ${profile.location}. ${profile.headlineLines.join(" ")}`}
>
  <div class="p-3 md:p-6 lg:p-10">
    <div
      class="mx-auto max-w-340 rounded-[28px] bg-paper ring-1 ring-line ring-inset px-5 pt-7 pb-6 md:px-10 lg:rounded-xl lg:px-18 lg:pt-10 lg:pb-8"
    >
      <SiteHeader />
      <main>
        <Intro />
        <FeaturedRole />
        <Experience />
        <About />
        <GitHubActivity />
        <Contact />
      </main>
      <SiteFooter />
    </div>
  </div>
  <ChatWidget />
</Layout>
