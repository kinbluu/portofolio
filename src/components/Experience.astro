---
import { experience } from "../data/profile";
---

<section
  id="experience"
  aria-labelledby="experience-title"
  class="flex flex-col gap-7 py-12 lg:gap-8 lg:py-16"
  data-skeleton-reveal
>
  <h2 id="experience-title" class="type-h2" data-skeleton-item>Along the way.</h2>
  <ol class="flex flex-col gap-7 lg:gap-8">
    {
      experience.map(({ icon: Icon, ...role }) => (
        <li class="flex flex-col gap-3 border-t border-line pt-6 lg:flex-row lg:gap-10 lg:pt-7">
          <p class="text-caption text-muted lg:w-54 lg:shrink-0 lg:text-body" data-skeleton-item>{role.dates}</p>
          <div class="flex min-w-0 flex-1 flex-col gap-2">
            <h3 class="flex items-center gap-3 type-h3" data-skeleton-item>
              <Icon size={18} class="shrink-0 text-accent" />
              {role.title}
            </h3>
            <p class="text-body text-muted" data-skeleton-item>{role.organization}</p>
            <p class="text-body-l" data-skeleton-item>{role.description}</p>
            <p class="text-caption text-muted" data-skeleton-item>{role.stack}</p>
          </div>
        </li>
      ))
    }
  </ol>
</section>
