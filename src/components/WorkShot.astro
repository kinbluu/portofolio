---
import Check from "@lucide/astro/icons/check";
import { featuredRole } from "../data/profile";

const rows = [
  { width: "68%", status: "Present" },
  { width: "54%", status: "Present" },
  { width: "72%", status: "Present" },
  { width: "61%", status: "Present" },
  { width: "66%", status: "Present" },
  { width: "49%", status: "Present" },
  { width: "58%", status: "Late" },
  { width: "52%", status: "Pending" },
];
---

<figure class="work-shot" data-reveal="fade">
  <div class="work-shot-stage">
    <div
      class="work-shot-window"
      role="img"
      aria-label="Interface illustration of the LEAP platform. A sidebar lists Registration, Scheduling, Attendance and Report cards. The attendance panel shows four sessions with record statuses, and a report card panel shows the draft, review and publish stages."
    >
      <div class="ws-bar" aria-hidden="true">
        <span class="ws-dots">
          <i></i>
          <i></i>
          <i></i>
        </span>
        <span class="ws-address">LEAP admin / attendance</span>
      </div>
      <div class="ws-body" aria-hidden="true">
        <aside class="ws-side">
          <p class="ws-brand">
            LEAP <span>Admin</span>
          </p>
          <p class="ws-side-label">Modules</p>
          <ul class="ws-nav">
            {featuredRole.modules.map(({ name, icon: Icon }) => (
              <li
                class:list={[
                  "ws-nav-item",
                  { "is-current": name === "Attendance" },
                ]}
              >
                <Icon size={14} stroke-width={1.75} />
                <span>{name}</span>
              </li>
            ))}
          </ul>
        </aside>
        <div class="ws-main">
          <div class="ws-head">
            <div>
              <p class="ws-eyebrow">Attendance</p>
              <p class="ws-title">Daily records</p>
            </div>
          </div>
          <div class="ws-table">
            <div class="ws-row ws-row--head">
              <span>Student</span>
              <span>Status</span>
            </div>
            {rows.map(({ width, status }) => (
              <div class="ws-row">
                <span class="ws-fill" style={`--w: ${width}`}></span>
                <span
                  class:list={[
                    "ws-status",
                    {
                      "is-pending": status === "Pending",
                      "is-late": status === "Late",
                    },
                  ]}
                >
                  {status}
                </span>
              </div>
            ))}
          </div>
        </div>
        <aside class="ws-panel">
          <p class="ws-eyebrow">Report cards</p>
          <p class="ws-panel-title">Approval stages</p>
          <ol class="ws-steps">
            <li class="ws-step is-done">
              <span class="ws-step-icon">
                <Check size={10} stroke-width={3} />
              </span>
              <span>Draft</span>
              <span class="ws-step-state">Done</span>
            </li>
            <li class="ws-step is-done">
              <span class="ws-step-icon">
                <Check size={10} stroke-width={3} />
              </span>
              <span>Review</span>
              <span class="ws-step-state">Done</span>
            </li>
            <li class="ws-step is-current">
              <span class="ws-step-icon">
                <i></i>
              </span>
              <span>Publish</span>
              <span class="ws-step-state">Next</span>
            </li>
          </ol>
          <p class="ws-panel-note">Reviewed before publishing.</p>
        </aside>
      </div>
    </div>
  </div>
  <figcaption>
    Interface illustration of the LEAP modules, not a screenshot.
  </figcaption>
</figure>

<style>
  .work-shot {
    width: min(100%, 58rem);
    margin: clamp(2rem, 5vw, 3.25rem) auto 0;
  }

  .work-shot-stage {
    position: relative;
    overflow: hidden;
    aspect-ratio: 2 / 1;
    border: 1px solid var(--rm3-line);
    border-radius: var(--rm3-radius-lg);
    background: var(--rm3-soft);
  }

  .work-shot-window {
    position: absolute;
    top: clamp(14px, 3vw, 28px);
    left: 3%;
    display: flex;
    width: 94%;
    height: 118%;
    flex-direction: column;
    overflow: hidden;
    border: 1px solid var(--rm3-line);
    border-radius: var(--rm3-radius-md) var(--rm3-radius-md) 0 0;
    background: var(--rm3-paper);
    box-shadow: 0 24px 60px -30px var(--rm3-shadow-strong);
    font-family: var(--font-manrope), sans-serif;
  }

  .ws-bar {
    display: flex;
    height: 38px;
    flex: none;
    align-items: center;
    gap: 12px;
    border-bottom: 1px solid var(--rm3-line);
    background: var(--rm3-soft);
    padding-inline: 14px;
  }

  .ws-dots {
    display: flex;
    flex: none;
    gap: 5px;
  }

  .ws-dots i {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--rm3-line);
  }

  .ws-address {
    width: min(100%, 16rem);
    margin-inline: auto;
    overflow: hidden;
    border-radius: var(--rm3-radius-pill);
    background: var(--rm3-paper);
    padding: 5px 12px;
    color: var(--rm3-muted);
    font-size: 11px;
    line-height: 1.3;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .ws-body {
    display: grid;
    flex: 1;
    grid-template-columns: 10.5rem minmax(0, 1fr) 12rem;
    min-height: 0;
  }

  .ws-side {
    border-right: 1px solid var(--rm3-line);
    padding: 18px 14px;
  }

  .ws-brand {
    margin: 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }

  .ws-brand span {
    color: var(--rm3-muted);
    font-weight: 500;
  }

  .ws-side-label {
    margin: 18px 8px 8px;
    color: var(--rm3-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ws-nav {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .ws-nav-item {
    display: flex;
    align-items: center;
    gap: 8px;
    border-radius: var(--rm3-radius-sm);
    padding: 7px 8px;
    color: var(--rm3-muted);
    font-size: 12px;
    line-height: 1.3;
  }

  .ws-nav-item :global(svg) {
    flex: none;
  }

  .ws-nav-item.is-current {
    background: var(--rm3-tint);
    color: var(--rm3-accent);
    font-weight: 600;
  }

  .ws-main {
    min-width: 0;
    padding: 18px 18px 0;
  }

  .ws-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 12px;
    border-bottom: 1px solid var(--rm3-line);
    padding-bottom: 14px;
  }

  .ws-eyebrow {
    margin: 0;
    color: var(--rm3-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .ws-title {
    margin: 3px 0 0;
    font-size: 15px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .ws-table {
    margin-top: 10px;
  }

  .ws-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 4.5rem;
    align-items: center;
    gap: 12px;
    min-height: 36px;
    border-bottom: 1px solid var(--rm3-line);
    font-size: 11.5px;
  }

  .ws-row:last-child {
    border-bottom: 0;
  }

  .ws-row--head {
    min-height: 28px;
    color: var(--rm3-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ws-fill {
    display: block;
    width: var(--w, 60%);
    height: 6px;
    border-radius: var(--rm3-radius-pill);
    background: var(--rm3-gh-0);
  }

  .ws-status {
    justify-self: end;
  }

  .ws-status.is-pending {
    color: var(--rm3-accent);
    font-weight: 600;
  }

  .ws-status.is-late {
    color: var(--rm3-muted);
  }

  .ws-panel {
    border-left: 1px solid var(--rm3-line);
    background: color-mix(in srgb, var(--rm3-soft) 45%, var(--rm3-paper));
    padding: 18px 16px;
  }

  .ws-panel-title {
    margin: 3px 0 0;
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }

  .ws-steps {
    display: flex;
    flex-direction: column;
    margin: 14px 0 0;
    padding: 0;
    list-style: none;
  }

  .ws-step {
    display: grid;
    grid-template-columns: 16px minmax(0, 1fr) auto;
    align-items: center;
    gap: 8px;
    border-top: 1px solid var(--rm3-line);
    padding: 8px 0;
    color: var(--rm3-muted);
    font-size: 12px;
  }

  .ws-step:first-child {
    border-top: 0;
    padding-top: 0;
  }

  .ws-step.is-done,
  .ws-step.is-current {
    color: var(--rm3-ink);
  }

  .ws-step.is-current {
    color: var(--rm3-accent);
    font-weight: 600;
  }

  .ws-step-icon {
    display: grid;
    width: 16px;
    height: 16px;
    place-items: center;
    border: 1px solid var(--rm3-line);
    border-radius: 50%;
  }

  .ws-step.is-done .ws-step-icon {
    border-color: var(--rm3-ink);
    background: var(--rm3-ink);
    color: var(--rm3-paper);
  }

  .ws-step.is-current .ws-step-icon {
    border-color: var(--rm3-accent);
  }

  .ws-step-icon i {
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--rm3-accent);
  }

  .ws-step-state {
    color: var(--rm3-muted);
    font-size: 10px;
    font-weight: 600;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .ws-step.is-current .ws-step-state {
    color: var(--rm3-accent);
  }

  .ws-panel-note {
    margin: 14px 0 0;
    color: var(--rm3-muted);
    font-size: 10.5px;
    line-height: 1.5;
  }

  figcaption {
    margin-top: 0.875rem;
    color: var(--rm3-muted);
    font-size: 0.8125rem;
    line-height: 1.5;
    text-align: center;
  }

  @media (max-width: 820px) {
    .work-shot-stage {
      aspect-ratio: 3 / 2;
    }

    .ws-body {
      grid-template-columns: minmax(0, 1fr) 12rem;
    }

    .ws-side {
      display: none;
    }
  }

  @media (max-width: 560px) {
    .work-shot-stage {
      width: 100%;
      aspect-ratio: 4 / 3;
      min-height: 21rem;
      border-radius: var(--rm3-radius-md);
    }

    .work-shot-window {
      top: 16px;
      left: 0;
      width: 100%;
      height: calc(100% + 24px);
      border-radius: var(--rm3-radius-md) var(--rm3-radius-md) 0 0;
    }

    .ws-address {
      width: min(100%, 13rem);
      font-size: 10px;
    }

    .ws-body {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      align-content: start;
      overflow: hidden;
    }

    .ws-main {
      padding: 16px 16px 0;
    }

    .ws-row {
      grid-template-columns: minmax(0, 1fr) 4rem;
      gap: 8px;
      min-height: 30px;
      font-size: 11px;
    }

    .ws-row:nth-child(n + 4) {
      display: none;
    }

    .ws-panel {
      margin-top: 8px;
      border-top: 1px solid var(--rm3-line);
      border-left: 0;
      padding: 10px 16px 12px;
    }

    .ws-steps {
      flex-direction: row;
      gap: 8px;
      margin-top: 8px;
    }

    .ws-step {
      grid-template-columns: 16px minmax(0, 1fr);
      border-top: 0;
      padding: 3px 0;
      font-size: 11px;
    }

    .ws-step:first-child {
      padding-top: 3px;
    }

    .ws-step-state,
    .ws-panel-note {
      display: none;
    }
  }
</style>
