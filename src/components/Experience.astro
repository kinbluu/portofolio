---
import { experience } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("experience");
---

<section
  id={chapter.id}
  aria-labelledby="experience-title"
  class="editorial-section"
>
  <div class="editorial-inner editorial-measure">
    <h2 id="experience-title">
      Work <em>experience.</em>
    </h2>
    <ol class="editorial-experience">
      {experience.map((role) => (
        <li>
          <p class="editorial-meta">{role.dates}</p>
          <h3>{role.title}</h3>
          <p class="editorial-organization">{role.organization}</p>
          <p class="editorial-copy">{role.description}</p>
          <p class="editorial-tags">{role.stack}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
