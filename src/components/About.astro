---
import { about, skills } from "../data/profile";
---

<section
  id="about"
  aria-labelledby="about-title"
  class="studio-chapter"
  data-studio-chapter
  data-studio-side="right"
  data-studio-label="The everyday tools"
>
  <div class="studio-copy">
    <h2 id="about-title">
      {about.titleLines[0]}
      <br />
      <em>{about.titleLines[1]}</em>
    </h2>
    <p class="studio-description">{about.description}</p>
    <ul class="studio-practices">
      {about.practices.map(({ icon: Icon, label }) => (
        <li>
          <Icon size={16} />
          {label}
        </li>
      ))}
    </ul>
    <h3 class="studio-toolkit-title">My everyday toolkit.</h3>
    <dl class="studio-toolkit">
      {skills.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
