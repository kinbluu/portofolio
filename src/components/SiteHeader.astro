---
import { navigation, profile } from "../data/profile";
import PluckedLink from "./PluckedLink.astro";
import ThemeToggle from "./ui/ThemeToggle.astro";

const isHome = Astro.url.pathname === "/";
const navHref = (href: string) =>
  isHome || !href.startsWith("#") ? href : `/${href}`;
---

<span
  class="site-header-sentinel"
  data-header-sentinel
  aria-hidden="true"
></span>
<div class="site-header-dock" data-header-dock>
  <header class="site-header" data-site-header>
    <span class="site-progress" aria-hidden="true">
      <span data-scroll-progress></span>
    </span>
    <PluckedLink
      class="site-wordmark"
      href={isHome ? "#top" : "/"}
      current={isHome}
    >
      {profile.wordmark}
    </PluckedLink>
    <div class="site-header-actions">
      <nav class="site-desktop-nav" aria-label="Main navigation">
        {navigation.map((link) => (
          <PluckedLink href={navHref(link.href)}>{link.label}</PluckedLink>
        ))}
      </nav>
      <ThemeToggle />
      <details class="site-mobile-menu" data-navigation-menu>
        <summary>
          Menu <span aria-hidden="true">+</span>
        </summary>
        <nav aria-label="Mobile navigation">
          {navigation.map((link) => (
            <PluckedLink href={navHref(link.href)}>{link.label}</PluckedLink>
          ))}
        </nav>
      </details>
    </div>
  </header>
</div>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(
    "[data-navigation-menu]",
  );
  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
  menu?.addEventListener("keydown", (event) => {
    if (
      event.key === "Enter" &&
      event.target === menu.querySelector("summary")
    ) {
      event.preventDefault();
      menu.open = !menu.open;
    } else if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });

  // The floating pill only exists once a script is there to keep it off the
  // content. Without it the header stays in flow, exactly as it renders without
  // JavaScript.
  const dock = document.querySelector<HTMLElement>("[data-header-dock]");
  const header = document.querySelector<HTMLElement>("[data-site-header]");
  const sentinel = document.querySelector<HTMLElement>(
    "[data-header-sentinel]",
  );

  if (dock && header && sentinel) {
    dock.toggleAttribute("data-sticky", true);
    const offset = parseFloat(getComputedStyle(dock).top) || 0;
    new IntersectionObserver(
      (entries) => {
        const [entry] = entries;
        if (entry) {
          header.toggleAttribute("data-floating", !entry.isIntersecting);
        }
      },
      { rootMargin: `-${offset}px 0px 0px 0px` },
    ).observe(sentinel);
  }
</script>
