---
import { experience } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("experience");
---

<section
  id={chapter.id}
  aria-labelledby="experience-title"
  class="studio-chapter"
  data-studio-chapter
  data-studio-side="left"
  data-studio-label="The collected experience"
>
  <div class="studio-copy">
    <p class="studio-section-label">
      <span>
        {chapter.number} / {chapter.label}
      </span>
      <span>Career notes</span>
    </p>
    <h2 id="experience-title">
      Along <em>the way.</em>
    </h2>
    <ol class="studio-experience">
      {experience.map((role) => (
        <li data-experience-item>
          <p class="studio-meta">{role.dates}</p>
          <h3>{role.title}</h3>
          <p class="studio-organization">{role.organization}</p>
          <p class="studio-description">{role.description}</p>
          <p class="studio-role-stack">{role.stack}</p>
        </li>
      ))}
    </ol>
  </div>
</section>
