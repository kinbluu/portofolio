---
import MapPin from "@lucide/astro/icons/map-pin";
import { profile } from "../data/profile";
import Button from "./ui/Button.astro";
---

<section aria-labelledby="intro-title" class="flex flex-col gap-5 py-10 lg:gap-6 lg:pt-16 lg:pb-14">
  <p class="flex items-center gap-3 text-micro text-muted lg:text-body">
    <MapPin size={16} class="shrink-0" />
    {profile.location} · {profile.role}
  </p>
  <h1 id="intro-title" class="type-display">
    {profile.nameLines[0]}{" "}<br class="lg:hidden" />
    {profile.nameLines[1]}
  </h1>
  <p class="type-headline">
    {profile.headlineLines[0]}{" "}<br class="max-lg:hidden" />
    {profile.headlineLines[1]}
  </p>
  <div class="flex items-center gap-2 lg:gap-3">
    <Button href={`mailto:${profile.email}`}>Let’s talk</Button>
    <Button href={profile.linkedin} variant="secondary">LinkedIn</Button>
  </div>
</section>
