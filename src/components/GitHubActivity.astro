---
import GitHubCalendar from "./GitHubCalendar.astro";
import GitHubCalendarSkeleton from "./GitHubCalendarSkeleton.astro";
---

<section id="github" aria-labelledby="github-title" class="flex flex-col gap-5 pb-12 lg:pb-16">
  <h2 id="github-title" class="type-h2">GitHub activity.</h2>
  <div class="min-w-0 rounded-md bg-soft p-5 ring-1 ring-line ring-inset lg:rounded-lg lg:p-7">
    <GitHubCalendar server:defer>
      <GitHubCalendarSkeleton slot="fallback" />
    </GitHubCalendar>
  </div>
</section>
