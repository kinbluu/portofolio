---
import About from "../components/About.astro";
import ChatWidget from "../components/ChatWidget.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import FeaturedRole from "../components/FeaturedRole.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import Intro from "../components/Intro.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import StudioScene from "../components/StudioScene.astro";
import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.role} in ${profile.location}. ${profile.headlineLines.join(" ")}`}
>
  <a class="studio-skip" href="#work">
    Skip to work
  </a>
  <SiteHeader />
  <StudioScene />
  <main id="main-content" class="studio-story">
    <Intro />
    <FeaturedRole />
    <Experience />
    <About />
    <GitHubActivity />
    <Contact />
  </main>
  <SiteFooter />
  <ChatWidget />
</Layout>
