---
import { buildCalendarView, contributionLevelClasses, getContributionCalendar } from "../lib/github";
import snapshot from "../data/github-snapshot.json";
import ContributionGrid from "./ContributionGrid.astro";
import TextLink from "./ui/TextLink.astro";

const calendar = await getContributionCalendar();
// Rendered at build as the fallback, then re-rendered live as a server island (see GitHubActivity).
// Don't let browsers pin the snapshot fallback; live data matches the server's 1h TTL.
Astro.response.headers.set(
  "Cache-Control",
  calendar.capturedAt === snapshot.capturedAt ? "no-store" : "public, max-age=3600",
);
const year = buildCalendarView(calendar.days);
const recent = buildCalendarView(calendar.days, 90);
const count = new Intl.NumberFormat("en-US");
const updatedOn = new Intl.DateTimeFormat("en-GB", {
  day: "numeric",
  month: "short",
  year: "numeric",
  timeZone: "UTC",
}).format(new Date(calendar.capturedAt));
---

<div class="flex flex-col gap-5">
  <div class="flex flex-col gap-1">
    <p class="type-stat">
      <span class="lg:hidden">{count.format(recent.total)} contributions</span>
      <span class="max-lg:hidden">{count.format(year.total)} contributions</span>
    </p>
    <p class="text-micro text-muted lg:text-caption">
      <span class="lg:hidden">Last 90 days</span>
      <span class="max-lg:hidden">Last year</span>
      {" "}· Updated {updatedOn}
    </p>
  </div>
  <!-- ponytail: 90-day view has ~13 columns, capped so tablets don't get giant cells. -->
  <ContributionGrid view={recent} class="max-w-96 lg:hidden" />
  <ContributionGrid view={year} class="max-lg:hidden" />
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <TextLink href={`https://github.com/${calendar.login}`} class="font-medium">@{calendar.login}</TextLink>
    <div class="flex items-center gap-2 text-micro text-muted">
      <span>Less</span>
      {contributionLevelClasses.map((level) => <span class:list={["size-3 rounded-xs", level]} aria-hidden="true" />)}
      <span>More</span>
    </div>
  </div>
</div>
