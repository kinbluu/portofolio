---
import Check from "@lucide/astro/icons/check";
import GraduationCap from "@lucide/astro/icons/graduation-cap";
import { featuredRole } from "../data/profile";
import Badge from "./ui/Badge.astro";
import CountUp from "./ui/CountUp.astro";
import IconTile from "./ui/IconTile.astro";
---

<section
  id="work"
  aria-labelledby="work-title"
  class="flex flex-col gap-7 rounded-md bg-soft p-6 motion-safe:enter-4 lg:gap-10 lg:rounded-lg lg:p-12"
>
  <div class="flex items-center justify-between gap-3 lg:gap-6">
    <Badge>{featuredRole.badge}</Badge>
    <p class="text-body text-muted">{featuredRole.dates}</p>
  </div>
  <div class="flex flex-col gap-7 lg:gap-10 xl:flex-row xl:gap-16">
    <div class="contents lg:flex lg:flex-col lg:gap-8 xl:min-w-0 xl:flex-1">
      <div class="order-1 flex flex-col gap-3 lg:order-none lg:gap-4">
        <h2 id="work-title" class="type-feature">
          {featuredRole.titleLines[0]}{" "}<br class="max-lg:hidden" />
          {featuredRole.titleLines[1]}
        </h2>
        <p class="flex gap-2 text-body font-medium lg:items-center lg:text-body-l">
          <GraduationCap size={18} class="shrink-0 text-accent" />
          {featuredRole.employer}
        </p>
        <p class="text-body text-muted lg:max-w-130 lg:text-body-l">{featuredRole.description}</p>
      </div>
      <dl
        class="order-2 grid grid-cols-3 gap-x-4 border-y border-line py-5 lg:order-none lg:flex lg:items-center lg:gap-10 lg:border-y-0 lg:py-0"
      >
        {
          featuredRole.figures.map((figure, index) => (
            <Fragment>
              {index > 0 && <span class="hidden h-14 w-px bg-line lg:block" aria-hidden="true" />}
              <div class="flex flex-col-reverse gap-0.5">
                <dt class="text-micro text-muted lg:text-caption">
                  <span class="lg:hidden">{figure.shortCaption}</span>
                  <span class="max-lg:hidden">{figure.caption}</span>
                </dt>
                <dd class="type-figure"><CountUp value={figure.value} prefix={figure.prefix} /></dd>
              </div>
            </Fragment>
          ))
        }
      </dl>
      <ul class="order-4 flex flex-wrap gap-2 lg:order-none" aria-label="Tech stack">
        {
          featuredRole.stack.map((item) => (
            <li
              class="rounded-pill bg-paper px-3.5 py-1.5 text-caption font-medium ring-1 ring-line ring-inset"
            >
              {item}
            </li>
          ))
        }
      </ul>
    </div>
    <div
      class="order-3 rounded-md bg-paper px-4 py-1 ring-1 ring-line ring-inset lg:order-none lg:px-6 lg:py-2 xl:w-110 xl:shrink-0"
    >
      <div class="flex items-center justify-between py-3.5 lg:py-4">
        <h3 class="text-caption font-medium text-muted">What I built</h3>
        <p class="text-micro text-muted">{featuredRole.modules.length} modules</p>
      </div>
      <ul>
        {
          featuredRole.modules.map(({ icon: Icon, name, detail }) => (
            <li class="flex items-center gap-4 border-t border-line py-3.5 lg:py-4">
              <IconTile>
                <Icon size={20} />
              </IconTile>
              <div class="flex min-w-0 flex-1 flex-col gap-0.5">
                <p class="text-label font-medium">{name}</p>
                <p class="text-caption text-muted">{detail}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
  <div class="flex flex-col gap-2.5 border-t border-line pt-5 lg:flex-row lg:items-center lg:gap-7 lg:pt-6">
    <p class="text-caption font-medium text-muted">Built for reliability</p>
    <ul class="grid grid-cols-2 gap-x-3 gap-y-2.5 lg:flex lg:gap-7">
      {
        featuredRole.practices.map((practice) => (
          <li class="flex items-center gap-1.5 text-caption whitespace-nowrap">
            <Check size={16} class="shrink-0 text-accent" />
            {practice}
          </li>
        ))
      }
    </ul>
  </div>
</section>
