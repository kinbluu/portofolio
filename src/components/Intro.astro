---
import { profile } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("top");
---

<section
  id={chapter.id}
  aria-labelledby="intro-title"
  class="editorial-section editorial-intro"
>
  <div class="editorial-inner editorial-intro-inner">
    <p class="editorial-person">{profile.name}</p>
    <h1 id="intro-title">
      {profile.headlineLines[0]}{" "}
      <em>{profile.headlineLines[1].replaceAll("-", "\u2011")}</em>
    </h1>
    <p class="editorial-lede">
      {profile.role} · {profile.location}
    </p>
    <nav class="editorial-actions" aria-label="Contact and main navigation">
      <a
        class="editorial-link editorial-link-primary"
        href={"mailto:" + profile.email}
      >
        Contact me
      </a>
      <a
        class="editorial-link"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
      <a class="editorial-link" href="#work">
        View my work
      </a>
    </nav>
  </div>
</section>
