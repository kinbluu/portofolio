---
import About from "../components/About.astro";
import ChatWidget from "../components/ChatWidget.astro";
import Contact from "../components/Contact.astro";
import Experience from "../components/Experience.astro";
import FeaturedRole from "../components/FeaturedRole.astro";
import GitHubActivity from "../components/GitHubActivity.astro";
import Intro from "../components/Intro.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";

import { profile } from "../data/profile";
import Layout from "../layouts/Layout.astro";
---

<Layout
  title={`${profile.name} · ${profile.role}`}
  description={`${profile.role} di ${profile.location}. ${profile.headlineLines.join(" ")}`}
>
  <a class="skip-link" href="#main-content">
    Lewati ke konten utama
  </a>
  <div class="page-shell">
    <SiteHeader />
    <main id="main-content">
      <Intro />
      <FeaturedRole />
      <Experience />
      <GitHubActivity />
      <About />
      <ChatWidget />
      <Contact />
    </main>
    <SiteFooter />
  </div>
</Layout>
