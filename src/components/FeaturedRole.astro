---
import { featuredRole } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
import WorkShot from "./WorkShot.astro";
const chapter = studioChapter("work");
---

<section id={chapter.id} aria-labelledby="work-title" class="editorial-section">
  <div class="editorial-inner editorial-wide">
    <h2 id="work-title" data-reveal>
      {featuredRole.titleLines[0]} <em>{featuredRole.titleLines[1]}</em>
    </h2>
    <p class="editorial-meta" data-reveal>
      {featuredRole.badge} · {featuredRole.employer}
      <br />
      {featuredRole.dates}
    </p>
    <p class="editorial-copy" data-reveal>
      {featuredRole.description}
    </p>
    <WorkShot />
    <dl class="editorial-facts" data-reveal>
      {featuredRole.figures
        .filter((figure) => figure.prefix === "~")
        .map((figure) => (
          <div>
            <dt>{figure.shortCaption} · approximate</dt>
            <dd>
              {figure.prefix}
              {new Intl.NumberFormat("en-US").format(figure.value)}
            </dd>
          </div>
        ))}
    </dl>
    <p class="editorial-tags" data-reveal aria-label="Technologies">
      {featuredRole.stack.join(" · ")}
    </p>
  </div>
</section>
