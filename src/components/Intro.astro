---
import ArrowDownRight from "@lucide/astro/icons/arrow-down-right";
import { profile } from "../data/profile";
---

<section
  id="top"
  aria-labelledby="intro-title"
  class="studio-chapter studio-intro"
  data-studio-chapter
  data-studio-side="left"
  data-studio-label="The room"
>
  <div class="studio-copy">
    <p class="studio-person">{profile.name}</p>
    <h1 id="intro-title">
      {profile.headlineLines[0]} <em>{profile.headlineLines[1]}</em>
    </h1>
    <p class="studio-intro-role">
      {profile.role}
      <span aria-hidden="true"> / </span>
      {profile.location}
    </p>
    <div class="studio-intro-links">
      <a class="studio-link" href={"mailto:" + profile.email}>
        Let’s talk <ArrowDownRight size={17} />
      </a>
      <a
        class="studio-quiet-link"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
      >
        LinkedIn
      </a>
    </div>
    <a href="#work" class="studio-enter">
      <span class="studio-enter-line" aria-hidden="true"></span>Scroll to step
      inside <ArrowDownRight size={16} />
    </a>
  </div>
</section>
