---
import GitHubCalendar from "./GitHubCalendar.astro";
import GitHubCalendarSkeleton from "./GitHubCalendarSkeleton.astro";
---

<section
  id="github"
  aria-labelledby="github-title"
  class="studio-chapter"
  data-studio-chapter
  data-studio-side="left"
  data-studio-label="The small, steady steps"
>
  <div class="studio-copy studio-copy-wide">
    <p class="studio-section-label">
      <span>04 / GitHub</span>
      <span>Contribution history</span>
    </p>
    <h2 id="github-title">
      Work in <em>the open.</em>
    </h2>
    <div class="studio-calendar">
      <GitHubCalendar server:defer>
        <GitHubCalendarSkeleton slot="fallback" />
      </GitHubCalendar>
    </div>
  </div>
</section>
