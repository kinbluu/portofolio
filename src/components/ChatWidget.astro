---
import { chat, profile } from "../data/profile";
import ChatPanel from "./ChatPanel";

const panelId = "chat-panel";
---

<section
  id="assistant"
  aria-labelledby="assistant-title"
  lang="en"
  class="chat-section"
>
  <div class="chat-section-heading">
    <h2 id="assistant-title">AI assistant</h2>
    <p>Ask about Rahmat's experience and work.</p>
  </div>
  <div id={panelId} class="chat-panel">
    <noscript>
      <style is:inline>
        .chat-panel astro-island {
          display: none !important;
        }
      </style>
      <p class="chat-no-script">
        This assistant requires JavaScript. You can still contact Rahmat at
        <a href={`mailto:${profile.email}`}>{profile.email}</a>.
      </p>
    </noscript>
    <ChatPanel
      client:visible

      assistant={chat.assistant}
      initials={chat.initials}
      status={chat.status}
      greeting={chat.greeting}
      suggestions={chat.suggestions}
      email={profile.email}
      github={profile.github}
      linkedin={profile.linkedin}
    />
  </div>
</section>
