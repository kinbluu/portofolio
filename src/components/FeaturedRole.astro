---
import { featuredRole } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("work");
---

<section id={chapter.id} aria-labelledby="work-title" class="editorial-section">
  <div class="editorial-inner editorial-measure">
    <h2 id="work-title">
      {featuredRole.titleLines[0]} <em>{featuredRole.titleLines[1]}</em>
    </h2>
    <p class="editorial-meta">
      {featuredRole.badge} · {featuredRole.employer}
      <br />
      {featuredRole.dates}
    </p>
    <p class="editorial-copy">{featuredRole.description}</p>
    <dl class="editorial-facts">
      {featuredRole.figures
        .filter((figure) => figure.prefix === "~")
        .map((figure) => (
          <div>
            <dt>{figure.shortCaption} · perkiraan</dt>
            <dd>
              {figure.prefix}
              {new Intl.NumberFormat("id-ID").format(figure.value)}
            </dd>
          </div>
        ))}
    </dl>
    <p class="editorial-tags" aria-label="Teknologi">
      {featuredRole.stack.join(" · ")}
    </p>
  </div>
</section>
