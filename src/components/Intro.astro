---
import { profile } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
import Mascot from "./Mascot";

const chapter = studioChapter("top");
---

<section
  id={chapter.id}
  aria-labelledby="intro-title"
  class="editorial-section editorial-intro"
  data-hero
>
  <div class="editorial-inner editorial-intro-inner">
    <div class="editorial-mascot-wrap enter-0">
      <Mascot
        client:load
        directions="/mascots/cat-directions.webp"
        reactions="/mascots/cat-reactions.webp"
        size={110}
        label="cat mascot"
        className="editorial-mascot"
      />
    </div>
    <p class="editorial-person enter-0">{profile.name}</p>
    <h1 id="intro-title">
      <span class="enter-1">{profile.headlineLines[0]}</span>{" "}
      <em class="enter-2">
        {profile.headlineLines[1].replaceAll("-", "\u2011")}
      </em>
    </h1>
    <p class="editorial-lede enter-3">
      {profile.role} · {profile.location}
    </p>
    <nav
      class="editorial-actions enter-4"
      aria-label="Contact and main navigation"
    >
      <a
        class="editorial-link editorial-link-primary"
        href={"mailto:" + profile.email}
        data-spring
      >
        Contact me
      </a>
      <a
        class="editorial-link"
        href={profile.linkedin}
        target="_blank"
        rel="noopener noreferrer"
        data-spring
      >
        LinkedIn
      </a>
      <a class="editorial-link" href="#work" data-spring>
        View my work
      </a>
    </nav>
  </div>
</section>
