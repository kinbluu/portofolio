---
import GitHubCalendar from "./GitHubCalendar.astro";
---

<section id="github" aria-labelledby="github-title" class="flex flex-col gap-5 pb-12 lg:pb-16">
  <h2 id="github-title" class="type-h2" data-reveal>GitHub activity.</h2>
  <div class="min-w-0 rounded-md bg-soft p-5 ring-1 ring-line ring-inset lg:rounded-lg lg:p-7" data-reveal>
    <!-- Build-time render shows instantly; the server island swaps in live data on each visit. -->
    <GitHubCalendar server:defer>
      <GitHubCalendar slot="fallback" />
    </GitHubCalendar>
  </div>
</section>
