---
import { contact, profile } from "../data/profile";
import Button from "./ui/Button.astro";
import TextLink from "./ui/TextLink.astro";
---

<section
  id="contact"
  aria-labelledby="contact-title"
  class="flex flex-col gap-4 rounded-md bg-soft px-5 py-7 lg:rounded-lg lg:p-10"
  data-reveal
>
  <h2 id="contact-title" class="type-h2">{contact.title}</h2>
  <p class="text-body-l text-muted">{contact.description}</p>
  <div class="flex flex-col items-start gap-6 pt-3 lg:flex-row lg:items-center lg:justify-between">
    <Button href={`mailto:${profile.email}`}>{profile.email}</Button>
    <div class="flex gap-6">
      <TextLink href={profile.linkedin}>LinkedIn</TextLink>
      <TextLink href={`tel:${profile.phone}`}>Phone</TextLink>
    </div>
  </div>
</section>
