---
import { navigation, profile } from "../data/profile";
---

<header class="site-header">
  <a class="site-wordmark" href="#top">
    {profile.wordmark}
  </a>
  <nav class="site-desktop-nav" aria-label="Navigasi utama">
    {navigation.map((link) => (
      <a href={link.href}>{link.label}</a>
    ))}
  </nav>
  <details class="site-mobile-menu" data-navigation-menu>
    <summary>
      Menu <span aria-hidden="true">+</span>
    </summary>
    <nav aria-label="Navigasi seluler">
      {navigation.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>
  </details>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(
    "[data-navigation-menu]",
  );
  menu?.querySelectorAll<HTMLAnchorElement>("a").forEach((link) => {
    link.addEventListener("click", () => {
      menu.open = false;
    });
  });
  menu?.addEventListener("keydown", (event) => {
    if (
      event.key === "Enter" &&
      event.target === menu.querySelector("summary")
    ) {
      event.preventDefault();
      menu.open = !menu.open;
    } else if (event.key === "Escape" && menu.open) {
      menu.open = false;
      menu.querySelector<HTMLElement>("summary")?.focus();
    }
  });
</script>
