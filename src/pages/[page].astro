---
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { trustPages } from "../data/site-content";
import Layout from "../layouts/Layout.astro";
export const prerender = false;
const page = trustPages.find(({ slug }) => slug === Astro.params.page);
if (!page) return Astro.rewrite("/404");
---

<Layout title={page.title} description={page.description}>
  <a class="skip-link" href="#main-content">
    Skip to main content
  </a>
  <div class="page-shell page-shell--fill">
    <SiteHeader />
    <main id="main-content" class="page-main">
      <article class="page-doc">
        <p class="page-doc-eyebrow">Site information</p>
        <h1>{page.title}</h1>
        <p class="page-doc-lede">{page.description}</p>
        {page.sections.map(({ title, paragraphs }) => (
          <section>
            <h2>{title}</h2>
            {paragraphs.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
          </section>
        ))}
        <nav class="page-doc-links" aria-label="Related links">
          {page.links.map(({ label, href }) => (
            <a href={href}>{label}</a>
          ))}
        </nav>
        <nav class="page-doc-links" aria-label="Site information">
          {trustPages.map(({ slug, title }) => (
            <a
              href={`/${slug}`}
              aria-current={slug === page.slug ? "page" : undefined}
            >
              {title}
            </a>
          ))}
        </nav>
      </article>
    </main>
    <SiteFooter />
  </div>
</Layout>
