---
import { Font } from "astro:assets";
import { profile } from "../data/profile";
import "../styles/global.css";
import "lenis/dist/lenis.css";
import "../styles/portfolio.css";
import "../styles/portfolio-sections.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
// Absolute URLs need `site` in astro.config.mjs; tags below are skipped until it is set.
const canonical = Astro.site && new URL(Astro.url.pathname, Astro.site).href;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Surabaya",
    addressCountry: "ID",
  },
  sameAs: [profile.github, profile.linkedin],
  ...(canonical && { url: canonical }),
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#e9e9eb"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111214"
    />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {Astro.site && <link rel="sitemap" href="/sitemap.xml" />}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-manrope" preload={[{ weight: 600 }]} />
    <Font cssVariable="--font-dm-sans" preload={[{ weight: 400 }]} />

    <title>{title}</title>
  </head>
  <body class="bg-canvas font-body text-ink antialiased">
    <slot />
    <script>
      import "../scripts/smooth-scroll";
    </script>
  </body>
</html>
