---
import { about, skills } from "../data/profile";
import { studioChapter } from "../data/studio-chapters";
const chapter = studioChapter("about");
---

<section
  id={chapter.id}
  aria-labelledby="about-title"
  class="editorial-section"
>
  <div class="editorial-inner editorial-measure">
    <h2 id="about-title">About me</h2>
    <p class="editorial-copy">{about.description}</p>
    <ul class="editorial-practices">
      {about.practices.map(({ label }) => (
        <li>{label}</li>
      ))}
    </ul>
    <h3 class="editorial-subtitle">Skills and tools</h3>
    <dl class="editorial-skills">
      {skills.map(({ label, value }) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))}
    </dl>
  </div>
</section>
