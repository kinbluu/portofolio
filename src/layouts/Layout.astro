---
import { Font } from "astro:assets";
import { profile } from "../data/profile";
import "../styles/global.css";
import "lenis/dist/lenis.css";
import "../styles/portfolio.css";
import "../styles/portfolio-sections.css";

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;
const canonical =
  !noindex && Astro.site && new URL(Astro.url.pathname, Astro.site).href;
const socialImage = Astro.site && new URL("/og.png", Astro.site).href;
const socialImageAlt = `${profile.name}, ${profile.role}, with a desk illustration.`;

const person = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  jobTitle: profile.role,
  description: `${profile.role} in ${profile.location}. ${profile.headlineLines.join(" ")}`,
  email: `mailto:${profile.email}`,
  telephone: profile.phone,
  address: {
    "@type": "PostalAddress",
    addressLocality: "Surabaya",
    addressCountry: "ID",
  },
  sameAs: [profile.github, profile.linkedin],
  url: Astro.site?.href,
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="author" content={profile.name} />
    <meta
      name="robots"
      content={
        noindex ? "noindex, follow" : "index, follow, max-image-preview:large"
      }
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: light)"
      content="#e9e9eb"
    />
    <meta
      name="theme-color"
      media="(prefers-color-scheme: dark)"
      content="#111214"
    />
    <meta name="generator" content={Astro.generator} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="profile" />
    <meta property="og:site_name" content={profile.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {socialImage && (
      <>
        <meta property="og:image" content={socialImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />
        <meta property="og:image:alt" content={socialImageAlt} />
      </>
    )}
    <meta
      name="twitter:card"
      content={socialImage ? "summary_large_image" : "summary"}
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {socialImage && (
      <>
        <meta name="twitter:image" content={socialImage} />
        <meta name="twitter:image:alt" content={socialImageAlt} />
      </>
    )}

    <script type="application/ld+json" set:html={JSON.stringify(person)} />
    {Astro.site && <link rel="sitemap" href="/sitemap.xml" />}
    <link rel="describedby" href="/llms.txt" type="text/plain" />
    {!noindex && (
      <link
        rel="alternate"
        type="text/markdown"
        href={
          Astro.url.pathname === "/"
            ? "/index.md"
            : `${Astro.url.pathname.replace(/\/$/, "")}.md`
        }
      />
    )}

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <Font cssVariable="--font-manrope" preload={[{ weight: 600 }]} />
    <Font cssVariable="--font-dm-sans" preload={[{ weight: 400 }]} />

    <title>{title}</title>
  </head>
  <body class="bg-canvas font-body text-ink antialiased">
    <slot />
    <script>
      import "../scripts/smooth-scroll";
      import "../scripts/reveal";
      import "../scripts/motion";
    </script>
  </body>
</html>
